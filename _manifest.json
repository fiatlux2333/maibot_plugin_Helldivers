{
  "manifest_version": 2,
  "id": "com.fiatlux.hd2-helper",
  "version": "1.0.0",
  "name": "绝地潜兵2情报助手",
  "description": "Helldivers 2 银河战争图片情报：Dashboard、统计、主要任务、地图、战线、全球事件、Steam 公告、Wiki、军需簿、Companion 截图翻译、B站银河快报订阅推送与数据源自诊断。移植自 astrbot_plugin_Helldivers v1.9.0。",
  "author": {
    "name": "牡蛎 (fiatlux2333)",
    "url": "https://github.com/fiatlux2333"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/fiatlux2333/Helldivers2-Chinese-Helper",
    "documentation": "https://github.com/fiatlux2333/Helldivers2-Chinese-Helper#readme",
    "issues": "https://github.com/fiatlux2333/Helldivers2-Chinese-Helper/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.9.0"
    },
    {
      "type": "python_package",
      "name": "Pillow",
      "version_spec": ">=10.0.0"
    }
  ],
  "plugin_type": "game",
  "capabilities": [
    "send.text",
    "send.image"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
